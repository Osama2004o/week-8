# Example Terraform variable values for the Agentic Hybrid RAG infrastructure.
# Copy to `terraform.tfvars` if customizing locally, and inject secrets via:
#   $env:TF_VAR_openrouter_api_key = "<your-openrouter-key>"
#   $env:TF_VAR_redis_auth_token   = "<16+-char-redis-auth-token>"

project_name      = "hybrid-rag"
environment       = "dev"
aws_region        = "us-east-1"
offline_plan_mode = true

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
enable_nat_gateway   = true

container_port      = 8000
container_image_tag = "latest"
ecs_task_cpu        = 2048
ecs_task_memory     = 4096
desired_count       = 1
llm_model           = "openrouter/free"
embedding_device    = "cpu"
log_retention_days  = 30

redis_node_type          = "cache.t3.small"
redis_engine_version     = "7.1"
redis_port               = 6379
redis_db                 = 0
redis_num_cache_clusters = 1

efs_performance_mode = "generalPurpose"
enable_s3_versioning = true
